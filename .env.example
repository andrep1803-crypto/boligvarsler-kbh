# Kopiér denne fil til .env og udfyld med dine egne værdier.
# .env må ALDRIG committes til git (den ligger i .gitignore).
# I GitHub Actions lægges de samme værdier ind som "Secrets" i stedet.

# --- Telegram ---
# Token får du fra @BotFather når du opretter botten (se README).
TELEGRAM_BOT_TOKEN=123456789:AA-din-bot-token-her
# Dit chat-ID finder du som beskrevet i README (brug @userinfobot).
TELEGRAM_CHAT_ID=123456789

# --- Kontaktinfo (sættes ind i søknadsteksten via {KONTAKT_...}) ---
KONTAKT_NAVN=Dit Navn
KONTAKT_TLF=+45 12345678
KONTAKT_ADRESSE=Din Gade 1, 1234 By

# --- Søknadstekst (valgfri) ---
# Din personlige ansøgningstekst. Brug \n for linjeskift. {KONTAKT_NAVN} og
# {KONTAKT_TLF} erstattes automatisk. Lad stå tom for at bruge soknad.txt.
SOKNAD_TEKST=
